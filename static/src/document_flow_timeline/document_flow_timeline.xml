<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_document_flow.DocumentFlowTimeline">
        <div class="o_df_timeline" t-att-class="statusClass">

            <!-- Headline: where the flow stands + overall progress -->
            <div class="o_df_timeline_head">
                <div class="o_df_timeline_head_text">
                    <span class="o_df_timeline_title"><t t-esc="progressTitle"/></span>
                    <span class="o_df_timeline_status"><t t-esc="statusLine"/></span>
                </div>
                <div class="o_df_timeline_flags">
                    <span t-if="record.data.single_signature" class="o_df_flag" t-att-title="singleSignatureLabel">
                        <i class="fa fa-pencil-square-o me-1"/><t t-esc="singleSignatureLabel"/>
                    </span>
                    <span t-if="confidentialityLabel" class="o_df_flag o_df_flag_secret" t-att-title="confidentialityLabel">
                        <i class="fa fa-lock me-1"/><t t-esc="confidentialityLabel"/>
                    </span>
                    <span t-if="validityDate" class="o_df_flag" t-att-class="validityClass">
                        <i class="fa fa-calendar-o me-1"/><t t-esc="validityLabel"/>
                    </span>
                </div>
            </div>

            <!-- Document milestones: who created / sent it and how it ended -->
            <div t-if="record.resId" class="o_df_milestones">
                <div t-foreach="milestones" t-as="ms" t-key="ms.key"
                     class="o_df_milestone" t-att-class="{ 'o_df_milestone_todo': !ms.done }">
                    <span class="o_df_log_dot" t-att-class="ms.cls">
                        <i class="fa" t-att-class="ms.icon"/>
                    </span>
                    <div class="o_df_milestone_text">
                        <span class="o_df_milestone_label"><t t-esc="ms.label"/></span>
                        <span class="o_df_milestone_meta">
                            <t t-if="ms.who"><t t-esc="ms.who"/> · </t><t t-esc="ms.when"/>
                        </span>
                    </div>
                </div>
            </div>

            <div t-if="signers.length" class="o_df_progress_row">
                <span class="o_df_progress_counter"><t t-esc="counterLabel"/></span>
            </div>

            <!-- Everyone responsible for the document, in order: the author who
                 uploads and sends it, then the signers. The connector leading to
                 a person fills in once the flow has reached them. -->
            <div t-if="signers.length" class="o_df_chain">
                <div t-foreach="steps" t-as="step" t-key="step.key"
                     class="o_df_step"
                     t-att-class="{ 'o_df_step_current': step.current, 'o_df_step_author': step.isAuthor }">
                    <div class="o_df_connector" t-att-class="step.connectorClass"/>
                    <div class="o_df_avatar_wrap">
                        <img t-if="step.avatar" class="o_df_avatar" t-att-src="step.avatar" alt=""/>
                        <span t-else="" class="o_df_avatar o_df_avatar_empty">
                            <i class="fa fa-user"/>
                        </span>
                        <span class="o_df_badge" t-att-class="step.visual.cls" t-att-title="step.visual.label">
                            <i class="fa" t-att-class="step.visual.icon"/>
                        </span>
                    </div>
                    <div class="o_df_step_name" t-att-title="step.name">
                        <t t-esc="step.name"/>
                    </div>
                    <div t-if="step.role" class="o_df_step_role">
                        <t t-esc="step.role"/>
                    </div>
                    <div class="o_df_step_state" t-att-class="step.visual.cls">
                        <t t-esc="step.visual.label"/>
                    </div>
                    <ul t-if="step.events.length" class="o_df_step_events">
                        <li t-foreach="step.events" t-as="ev" t-key="ev.key"
                            t-att-class="ev.cls" t-att-title="ev.title">
                            <i class="fa fa-fw" t-att-class="ev.icon"/>
                            <span class="o_df_ev_label"><t t-esc="ev.label"/></span>
                            <span class="o_df_ev_when"><t t-esc="ev.when"/></span>
                            <span t-if="ev.by" class="o_df_ev_by"><t t-esc="ev.by"/></span>
                        </li>
                    </ul>
                </div>
            </div>

            <div t-else="" class="o_df_empty">
                <i class="fa fa-user-plus me-2"/><t t-esc="emptyLabel"/>
            </div>

        </div>
    </t>

</templates>
